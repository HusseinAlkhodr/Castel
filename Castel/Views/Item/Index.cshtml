@model IEnumerable<Castel.DTO.GetItemDTO>

@{
    ViewData["Title"] = "قائمة المواد";
}

<h1>قائمة المواد</h1>

<p>
    <a asp-action="Create" class="btn btn-success">إضافة مادة</a>
</p>

<table class="table table-striped table-bordered text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>الرقم</th>
            <th>الباركود</th>
            <th>المادة</th>
            <th>سعر المبيع</th>
            <th>الكمية</th>
            <th>القسم</th>
            <th>المورد</th>
            <th>العمليات</th>
        </tr>
    </thead>
    <tbody>
        @{
            var i = 1;
        }
        @foreach (var item in Model)
        {
            <tr>
                <td>@(i++)</td>
                <td>@Html.DisplayFor(modelItem => item.Barcode)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.NetAmount)</td>
                <td>@Html.DisplayFor(modelItem => item.Qty)</td>
                <td>@Html.DisplayFor(modelItem => item.DivisionName)</td>
                <td>@Html.DisplayFor(modelItem => item.VendorName)</td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="Edit" asp-route-id="@item.id" class="btn btn-warning">تعديل</a> | 
                        <a asp-action="Details" asp-route-id="@item.id" class="btn btn-primary">عرض</a> | 
                        <a asp-action="Delete" asp-route-id="@item.id" class="btn btn-danger">حذف</a> | 
                        <a asp-action="EditPrice" asp-route-id="@item.id" class="btn btn-info">تعديل سعر</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
