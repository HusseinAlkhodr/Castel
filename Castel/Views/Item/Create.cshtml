@model Castel.DTO.AddItemDTO

@{
    ViewData["Title"] = "تعريف مادة";
}

<h1>تعريف مادة</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Barcode" class="control-label"></label>
                <input asp-for="Barcode" class="form-control" placeholder="ادخل قيمة الباركود" />
                <span asp-validation-for="Barcode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" placeholder="ادخل الوصف" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VendorId" class="control-label"></label>
                <select asp-for="VendorId" class="form-control" asp-items="@(ViewBag.Vendors as List<SelectListItem>)"></select>
                <span asp-validation-for="VendorId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DivisionId" class="control-label"></label>
                <select asp-for="DivisionId" class="form-control" asp-items="@(ViewBag.Divisions as List<SelectListItem>)"></select>
                <span asp-validation-for="DivisionId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="اضافة" class="btn btn-primary" /> |
                <a asp-action="Index" class="btnbtn-secondary">العودة الى قائمة الأقسام</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
