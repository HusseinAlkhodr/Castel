@model Castel.DTO.AddInvoiceItemDTO

@{
    ViewData["Title"] = "فاتورة بيع";
}

<h2>فاتورة بيع</h2>
<div class="row">
    <div class="col-md-8 mb-2">
        <label for="barcodeInput">أدخل الباركود:</label>
        <input type="text" id="barcodeInput" class="form-control" placeholder="أدخل رقم الباركود واضغط Enter" onkeydown="handleBarcodeInput(event)" />
    </div>
    <div class="col-md-4 mb-2">
        <label for="pdCurrency">اختر عملة الدفع:</label>
        <select id="pdCurrency" class="form-select" style="width:fit-content" name="currency" onchange="ChangePrice()">
            <option value="USD" selected>دولار أمريكي (USD)</option>
            <option value="SYP">ليرة سورية (SYP)</option>
        </select>
    </div>
</div>
<hr />
<div id="productDetails" class="mb-3 d-none">
    <h5>تفاصيل المنتج</h5>
    <p hidden><span id="pdId"></span></p>

    <div class="row">
        <div class="col-md-6 mb-2">
            <strong>الباركود:&nbsp;&nbsp;</strong> <span id="pdBarcode"></span>
        </div>
        <div class="col-md-6 mb-2">
            <strong>الوصف:&nbsp;&nbsp;</strong> <span id="pdDescription"></span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-2">
            <label for="pdType"><strong>النوع:&nbsp;&nbsp;</strong></label>
            <select id="pdType" class="form-select" onchange="updatePriceByType()"></select>
        </div>
        <div class="col-md-6 mb-2">
            <label for="pdQuantity">الكمية:&nbsp;&nbsp;</label>
            <input type="number" id="pdQuantity" value="1" min="1" class="form-control" style="width: 100px;" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-2">
            <label for="pdPrice">سعر القطعة:&nbsp;&nbsp;</label>
            <input type="number" id="pdPrice" class="form-control" style="width: 100px;" onchange="updatePriceByType()" />
        </div>
        <div class="col-md-6 mb-2">
            <label for="pdTotalPrice">السعر الاجمالي:&nbsp;&nbsp;</label>
            <input type="number" id="pdTotalPrice" class="form-control" style="width: 100px;" readonly />
        </div>
    </div>
    <button class="btn btn-success mt-2" onclick="addProductToTable()">إضافة</button>
</div>

<table class="table table-striped table-bordered text-center align-middle" id="invoiceTable">
    <thead class="table-dark">
        <tr>
            <!-- لا نعرض رأس ID لأنه مخفي -->
            <th>الباركود</th>
            <th>الوصف</th>
            <th>النوع</th>
            <th>السعر</th>
            <th>الكمية</th>
            <th>الإجمالي</th>
            <th>العمليات</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>
<div class="mt-3">
    <strong>الإجمالي الكلي:</strong> <span id="totalAmount">0</span>
</div>
<button class="btn btn-primary mt-3" id="submitButton" onclick="submitInvoice()" disabled>بيع</button>









@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const invoiceItems = [];
        let basePrice = 0;
        let basePriceInDollar = 0;
        function handleBarcodeInput(event)
        {
            if (event.key === "Enter") {
                const barcode = event.target.value.trim();
                fetch(`/Item/GetForSale?barcode=${barcode}`)
                    .then(response => {
                        if (!response.ok) throw new Error("المنتج غير موجود");
                        return response.json();
                    })
                    .then(product => {
                        const currency = document.getElementById("pdCurrency").value;
                        // تعبئة الحقول
                        document.getElementById("pdId").innerText = product.id;
                        document.getElementById("pdBarcode").innerText = product.barcode;
                        document.getElementById("pdDescription").innerText = product.description;
                        // السعر الأساسي بالدولار
                        basePriceInDollar = product.netAmountInDollar || 1;
                        basePrice = product.netAmount || 1;
                        if(currency == "USD"){
                            document.getElementById("pdPrice").value = basePriceInDollar;
                            document.getElementById("pdTotalPrice").value = basePriceInDollar;
                        }else if(currency == "SYP"){
                            document.getElementById("pdPrice").value = basePrice;
                            document.getElementById("pdTotalPrice").value = basePrice;
                        }
                        document.getElementById("pdQuantity").value = 1;
                        // تعبئة نوع المنتج في القائمة المنسدلة
                        const typeSelect = document.getElementById("pdType");
                        typeSelect.innerHTML = ""; // إفراغ القائمة أولاً
                        const types = [
                            { value: "Piece", text: "قطعة" },
                            { value: "Package", text: "طرد" },
                            { value: "Cruise", text: "كروز" }
                        ];
                        types.forEach(t => {
                            const opt = document.createElement("option");
                            opt.value = t.value;
                            opt.text = t.text;
                            if (t.text === product.typeName) opt.selected = true;
                            typeSelect.appendChild(opt);
                        });

                        // تحديث السعر حسب النوع مباشرة
                        updatePriceByType();
                        document.getElementById("productDetails").classList.remove("d-none");
                        invoiceItems.push(product);
                    })
                    .catch(err => {
                        alert(err.message);
                        document.getElementById("productDetails").classList.add("d-none");
                    });
            }
        }
        function updatePriceByType() {
            const type = document.getElementById("pdType").value;
            const price = parseFloat(document.getElementById("pdPrice").value);
            let finalPrice = 0;

            if (type === "Package") {
                finalPrice = price * 20;
            } else if (type === "Cruise") {
                finalPrice = price * 10;
            } else{
                finalPrice = price ;
            }

            document.getElementById("pdTotalPrice").value = finalPrice.toFixed(2);
        }
        function ChangePrice(){
            const currency = document.getElementById("pdCurrency").value;
            let finalPrice = basePrice;
            if(currency == "USD"){
                finalPrice = basePriceInDollar;
            } else if(currency == "SYP"){
                finalPrice = basePrice;
            }
            document.getElementById("pdPrice").value = finalPrice;
            updatePriceByType()

        }
        //اضافة المادة الى الجدول
        function addProductToTable() {
            const barcode = document.getElementById("pdBarcode").innerText;
            const description = document.getElementById("pdDescription").innerText;

            // احصل على النص الظاهر من القائمة (العربي)
            const typeSelect = document.getElementById("pdType");
            const typeValue = typeSelect.value;                              // مثل: "Package"
            const typeText = typeSelect.options[typeSelect.selectedIndex].text; // مثل: "طرد"
            const price = parseFloat(document.getElementById("pdTotalPrice").value);
            const quantity = parseInt(document.getElementById("pdQuantity").value);
            const item = invoiceItems.find(p => p.barcode === barcode);
            const id = item?.id || 0;

            const total = price * quantity;

            const row = document.createElement("tr");
            row.innerHTML = `
                <td style="display:none;">${id}</td>
                <td>${barcode}</td>
                <td>${description}</td>
                <td data-type="${typeValue}">${typeText}</td>
                <td>${price}</td>
                <td>${quantity}</td>
                <td>${total.toFixed(2)}</td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">🗑 حذف</button>
                </td>
            `;
            document.querySelector("#invoiceTable tbody").appendChild(row);
            updateSubmitButtonState();
            updateTotalAmount();

            // تنظيف
            document.getElementById("barcodeInput").value = "";
            document.getElementById("productDetails").classList.add("d-none");
        }
        function updateTotalAmount() {
            const rows = document.querySelectorAll("#invoiceTable tbody tr");
            let total = 0;
            rows.forEach(row => {
                total += parseFloat(row.children[6].innerText); // الإجمالي = العمود السادس
            });
            document.getElementById("totalAmount").innerText = total.toFixed(2);
        }
        function removeRow(button)
        {
            const row = button.closest("tr");
            row.remove();
            updateSubmitButtonState();
        }
        function updateSubmitButtonState() {
            const hasRows = document.querySelectorAll("#invoiceTable tbody tr").length > 0;
            document.getElementById("submitButton").disabled = !hasRows;
            document.getElementById("pdCurrency").disabled = hasRows;
        }
        function submitInvoice() {
            const rows = document.querySelectorAll("#invoiceTable tbody tr");
            const invoices = [];

            rows.forEach(row => {
                invoices.push({
                    id: parseInt(row.children[0].innerText),           // ID من العمود المخفي
                    barcode: row.children[1].innerText,
                    description: row.children[2].innerText,
                    type: row.children[3].getAttribute("data-type"), // القيمة البرمجية
                    typeName: row.children[3].innerText,
                    netAmount: parseFloat(row.children[4].innerText),
                    qty: parseInt(row.children[5].innerText),
                    payType : document.getElementById("pdCurrency").value
                });
            });
            fetch("/Invoice/CreateSaleInvoice", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(invoices)
            }).then(response => {
                if (!response.ok)
                    throw new Error("فشل البيع");
                return response.json();
            }).then(data => {
                showInvoiceResult(data,invoices);
            })

            .catch(error => alert("خطأ أثناء البيع: " + error.message));
        }
        const invoiceData = {
            invoiceNumber: '',
            items: []
        };

        function showInvoiceResult(data,invoices) {
            const now = new Date().toLocaleString("ar-EG", {
                day: '2-digit', month: 'long', year: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit',
                hour12: true
            });
            const itemTypeMap = {
                Piece: "قطعة",
                Package: "طرد",
                Cruise: "كروز"
            };
            // بنية الجدول وعناصره
            let totalAll = 0;
            let rowsHtml = invoices.map(item => {
                const lineTotal = item.netAmount * item.qty;
                totalAll += lineTotal;
                return `
                  <tr style="border-collapse: collapse;" border="1">
                    <td>${item.description}</td>
                    <td>${itemTypeMap[item.type]}</td>
                    <td>${item.netAmount.toFixed(2)}</td>
                    <td>${item.qty}</td>
                    <td>${lineTotal.toFixed(2)}</td>
                  </tr>`;
                }).join("");

                const htmlContent = 
                '<!DOCTYPE html>'+
                '<html lang="ar" dir="rtl">'+
                '<head>'+
                    '<meta charset="UTF-8">'+
                    '<title>فاتورة بيع<\/title>'+
                    '<style>'+
                        'body { font-family: Arial; padding: 20px; }'+
                        'h2 { text-align: center; margin-bottom: 0; }'+
                        'p { margin: 0.3em 0; }'+
                        'table { width: 100%; border-collapse: collapse; margin-top: 1em; }'+
                        'th, td { border: 1px solid black; padding: 8px; text-align: center; }'+
                        '.total-row { font-weight: bold; }'+
                    '<\/style>'+
                '<\/head>'+

                '<body>'+
                    '<h2 style="text-align: center;">مركز القلعة<\/h2><hr\/>'+
                    '<p><strong>التاريخ:</strong><span> '+`${now}`+'<\/span><\/p>'+
                    '<p><strong>رقم الفاتورة:</strong> <span> '+`${data.invoiceNumber}`+'<\/span><\/p><hr\/>'+
                    '<table style="width: 100%; border-collapse: collapse;" class="table" border="1">'+
                        '<thead>'+
                            '<tr>'+
                                '<th>الوصف<\/th>'+
                                '<th>النوع<\/th>'+
                                '<th>السعر الافرادي<\/th>'+
                                '<th>الكمية<\/th>'+
                                '<th>الإجمالي<\/th>'+
                            '<\/tr>'+
                        '<\/thead>'+
                        '<tbody>'+
                            `${rowsHtml}`+
                        '<\/tbody>'+
                    '<\/table>'+
                    '<p style="margin-top: 20px; text-align: left;">'+
                    '<strong>الإجمالي الكلي: </strong><span>'+`${totalAll.toFixed(2)}`+'<\/span><\/p>'
                    '<scr'+'ipt>'+
                        'window.onload = function () {'+
                        'window.print();'+
                        'setTimeout(() => window.close(), 800);'+
                    '}'+
                    '<\/scr'+'ipt>'+
                '<\/body>'+
                `<\/html>`;
                const win = window.open("", "_blank");
                win.document.open();
                win.document.write(htmlContent);
                win.document.close();
                win.focus();
                win.onafterprint = function () {
                    win.close();
                    if (win.opener) {
                            win.opener.location.reload();
                        }
                };
                win.print();

                
        }

    </script>

}
