@model Castel.DTO.AddInvoiceItemDTO

@{
    ViewData["Title"] = "فاتورة بيع";
}
<!--Invoice Header-->
<div class="row">
    <h2 class="col-md-4 mb-2">فاتورة بيع</h2>
    <div class="col-md-8 mb-2">
        <label>اختر عملة الدفع:</label>
        <div class="btn-group w-100" role="group" aria-label="Currency selection">
            <button type="button" id="btnSYP" class="btn btn-outline-primary active" onclick="selectCurrency('SYP')">ليرة سورية (SYP)</button>
            <button type="button" id="btnUSD" class="btn btn-outline-primary" onclick="selectCurrency('USD')">دولار أمريكي (USD)</button>
        </div>
        <input type="hidden" id="pdCurrency" value="SYP" />
    </div>
</div>
<hr />

<table class="table table-bordered table-hover text-center align-middle w-auto" id="invTable" style="table-layout: auto;">
    <thead class="table-dark">
        <tr>
            <th>الباركود</th>
            <th>الوصف</th>
            <th>النوع</th>
            <th>سعر القطعة</th>
            <th>الكمية</th>
            <th>الإجمالي</th>
            <th>العمليات</th>
        </tr>
    </thead>
    <tbody>
        <!-- صف الإدخال -->
        <tr id="inputRow" class="input-row">
            <td class="d-flex gap-1">
                <input type="text" class="form-control barcode-input" placeholder="ادخل الباركود" style="width: auto;"/>
                <button type="button" class="btn btn-outline-secondary" onclick="openSearchModal(this)">🔍</button>
            </td>

            <td style="width: auto;"><input type="text" class="form-control description-input" id="inputDescription" readonly /></td>
            <td>
                <select class="form-select type-select" style="width: 100px;" id="inputType" onchange="updateInputRowPrice()">
                    <option value="Piece">قطعة</option>
                    <option value="Package">طرد</option>
                    <option value="Cruise">كروز</option>
                </select>
            </td>
            <td style="width: auto;"><input type="number" class="form-control price-input" id="inputPrice" onchange="updateInputRowPrice()" /></td>
            <td style="width: 95px;"><input type="number" class="form-control quantity-input" id="inputQuantity" value="1" min="1" onchange="updateInputRowPrice()" /></td>
            <td style="width: auto;"><input type="number" class="form-control total-input" id="inputTotal" readonly /></td>
            <td>
                <button class="btn btn-success btn-sm" onclick="finalizeInputRow(this)">✔</button>
            </td>

            <td></td> <!-- خلية العمليات تبقى فارغة في صف الإدخال -->
        </tr>
    </tbody>
</table>

<div class="mt-3 text-end">
    <strong>عدد المواد:</strong> <span id="totalItems">0</span> &nbsp;&nbsp;
    <strong>الإجمالي الكلي:</strong> <span id="totalAmount">0</span>
    <span id="currencyLabel" class="curr">SYP</span>
</div>

<button class="btn btn-primary mt-3" id="submitButton" onclick="submitInvoice()" disabled>بيع</button>
<!-- Modal للبحث عن المواد -->
<div class="modal fade" id="itemSearchModal" tabindex="-1" aria-labelledby="itemSearchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="itemSearchModalLabel">البحث عن مادة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <input type="text" class="form-control mb-3" id="searchKeyword" placeholder="ابحث بالاسم أو الباركود..." />
                <table class="table table-hover text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>الباركود</th>
                            <th>الوصف</th>
                            <th>النوع</th>
                            <th>اختيار</th>
                        </tr>
                    </thead>
                    <tbody id="searchResults">
                        <tr><td colspan="4">ابدأ بالبحث...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>









@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        let currentRow = null;
        let dataRows = 0;
        //لمودل البحث
        document.getElementById('searchKeyword').addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                // نفذ ما تريده هنا عند الضغط على Enter
                 searchItems();
            }
        });
        
        //for select payment currency
        function selectCurrency(currency) {
            document.getElementById("pdCurrency").value = currency;

            document.getElementById("btnSYP").classList.remove("active");
            document.getElementById("btnUSD").classList.remove("active");

            if (currency === "SYP") {
                document.getElementById("btnSYP").classList.add("active");
                 document.getElementById("currencyLabel").textContent ="SYP";
             } else {
                document.getElementById("btnUSD").classList.add("active");
                document.getElementById("currencyLabel").textContent ="USD";
            }

            // إذا كان في عمليات تعتمد على تغيير العملة (مثل تحديث الأسعار)، نفذها هنا
            if (typeof onCurrencyChanged === "function") {
                onCurrencyChanged(currency);
            }
            
            updateTotalAmount();

        }
        //for add item to invoice
        function convertInputRowToDataRow(row) 
        {
            const barcode = row.querySelector('.barcode-input').value.trim();
            const description = row.querySelector('.description-input').value.trim();
            const typeSelect = row.querySelector('.type-select');
            const typeValue = typeSelect.value;
            const typeText = typeSelect.options[typeSelect.selectedIndex].text;
            const price = parseFloat(row.querySelector('.price-input').value);
            const quantity = parseInt(row.querySelector('.quantity-input').value);
            const total = parseFloat(row.querySelector('.total-input').value);

            if (!barcode || !description || !price || !quantity || !total) {
                alert('يرجى إكمال بيانات المنتج بشكل صحيح.');
                return false;
            }

            // تحقق إذا المنتج موجود مسبقاً (دمج الكميات)
            const tbody = document.querySelector('#invTable tbody');
            dataRows = Array.from(tbody.querySelectorAll('tr')).filter(r => !r.classList.contains('input-row'));
            let existingRow = null;
            dataRows.forEach
            (r => 
                {
                    if (r.children[0].innerText === barcode) 
                    {
                        existingRow = r;
                    }
                }
            );

            if (existingRow) 
            {
                // دمج الكميات والسعر الكلي فقط، لا تضيف صف جديد
                const oldQty = parseInt(existingRow.children[4].innerText);
                const newQty = oldQty + quantity;
                const newTotal = price * newQty;

                existingRow.children[4].innerText = newQty;
                existingRow.children[5].innerText = newTotal.toFixed(2);

                // امسح سطر الإدخال الحالي
                row.remove();
            } 
            else 
            {
                // تحويل السطر إلى عرض بيانات
                row.classList.remove('input-row');
                row.innerHTML = `
                    <td>${barcode}</td>
                    <td>${description}</td>
                    <td data-type="${typeValue}">${typeText}</td>
                    <td>${price.toFixed(2)}</td>
                    <td>${quantity}</td>
                    <td>${total.toFixed(2)}</td>
                    <td><button class="btn btn-danger btn-sm" onclick="removeRow(this)">🗑 حذف</button></td>
                `;
            }

            // أضف سطر إدخال جديد في الأسفل (إن لم يكن موجود)
            if (!tbody.querySelector('.input-row')) {
                addNewInputRow();
            }
            
            updateTotalAmount();
            return true;
        }
        //add new input row
        function addNewInputRow() {
            const tbody = document.querySelector('#invTable tbody');
            const tr = document.createElement('tr');
            tr.classList.add('input-row');
            tr.innerHTML = `
                <td class="d-flex gap-1">
                    <input type="text" class="form-control barcode-input" placeholder="ادخل الباركود" />
                    <button type="button" class="btn btn-outline-secondary" onclick="openSearchModal()">🔍</button>
                </td>
                <td><input type="text" class="form-control description-input" readonly /></td>
                <td>
                    <select class="form-select type-select">
                        <option value="Piece">قطعة</option>
                        <option value="Package">طرد</option>
                        <option value="Cruise">كروز</option>
                    </select>
                </td>
                <td><input type="number" class="form-control price-input" /></td>
                <td><input type="number" class="form-control quantity-input" value="1" min="1" /></td>
                <td><input type="number" class="form-control total-input" readonly /></td>
                <td>
                    <button class="btn btn-success btn-sm" onclick="finalizeInputRow(this)">✔</button>
                </td>
                <td></td>
            `;
            tbody.appendChild(tr);
            attachInputRowEvents(tr);
            tr.querySelector('.barcode-input').focus();
        }
        //barcode insert action
       function handleBarcodeInputEnter(event) 
       {
            if (event.key === 'Enter') {
                const row = event.target.closest('tr');
                const barcode = event.target.value.trim();
                if (!barcode) return;

                fetch(`/Item/GetForSale?barcode=${barcode}`)
                    .then(res => {
                        if (!res.ok) throw new Error('المادة غير موجودة');
                        return res.json();
                    })
                    .then(product => {
                        // تعبيئة بيانات المنتج في الصف
                        row.querySelector('.description-input').value = product.description || '';
                        row.querySelector('.price-input').value = document.getElementById('pdCurrency').value === 'USD'
                            ? (product.netAmountInDollar || 1)
                            : (product.netAmount || 1);

                        // تعيين نوع المنتج
                        const typeSelect = row.querySelector('.type-select');
                        for (let i = 0; i < typeSelect.options.length; i++) {
                            if (typeSelect.options[i].text === product.typeName) {
                                typeSelect.selectedIndex = i;
                                break;
                            }
                        }
                         
                        updateInputRowPrice(row); // هذا سيحسب total مباشرة بعد ملء البيانات

                        // لا تقم بتحويل السطر الآن (لا تستدع convertInputRowToDataRow)
                        // المستخدم يستطيع تعديل الكمية أو السعر ثم الضغط على زر "إضافة" أو Enter لاحقًا لإتمام التحويل (لو أردت).
                    })
                    .catch(err => {
                        alert(err.message);
                        clearInputRow(row);
                    });
            }
        }

        //update total from type
        function updateInputRowPrice(row) {
            const type = row.querySelector('.type-select').value;
            const price = parseFloat(row.querySelector('.price-input').value) || 0;
            const quantity = parseInt(row.querySelector('.quantity-input').value) || 1;

            let finalPrice = price;
            if (type === 'Package') finalPrice *= 20;
            else if (type === 'Cruise') finalPrice *= 10;

            row.querySelector('.total-input').value = (finalPrice * quantity).toFixed(2);
        }
        //clear input row content
        function clearInputRow(row) {
            row.querySelector('.barcode-input').value = '';
            row.querySelector('.description-input').value = '';
            row.querySelector('.price-input').value = '';
            row.querySelector('.quantity-input').value = 1;
            row.querySelector('.total-input').value = '';
            row.querySelector('.barcode-input').focus();
        }

        function removeRow(button) {
            button.closest('tr').remove();
            updateTotalAmount();
        }

        
        //update invoice total
        function updateTotalAmount() {
            
            const rows = document.querySelectorAll('#invTable tbody tr:not(.input-row)');
            let total = 0;
            rows.forEach(r => {
                total += parseFloat(r.children[5].innerText);
            });
            document.getElementById("totalAmount").innerText = total.toFixed(2);
            document.getElementById("totalItems").innerText = rows.length;

            const disableCurrency = dataRows.length > 0;
            alert(disableCurrency);
            document.getElementById("btnSYP").disabled = disableCurrency;
            document.getElementById("btnUSD").disabled = disableCurrency;

            const currency = document.getElementById("pdCurrency").value;
            document.getElementById("currencyLabel").innerText = `(${currency})`;
        }
        // ربط أحداث الإدخال على صف الإدخال الحالي
        function attachInputRowEvents(row) {
            row.querySelector('.barcode-input').addEventListener('keydown', handleBarcodeInputEnter);
            row.querySelector('.price-input').addEventListener('input', () => updateInputRowPrice(row));
            row.querySelector('.quantity-input').addEventListener('input', () => updateInputRowPrice(row));
            row.querySelector('.type-select').addEventListener('change', () => updateInputRowPrice(row));
        }
        // عند تحميل الصفحة اربط الأحداث على السطر الأول
        window.addEventListener('DOMContentLoaded', () => {
            const inputRow = document.querySelector('.input-row');
            attachInputRowEvents(inputRow);
        });

        // فتح المودال
        function openSearchModal(button) 
        {
            currentRow = button.closest('tr');
            const modal = new bootstrap.Modal(document.getElementById('itemSearchModal'));
            document.getElementById('searchKeyword').value = '';
            document.getElementById('searchResults').innerHTML = '<tr><td colspan="4">ابدأ بالبحث...</td></tr>';
            modal.show();
        }

        // تنفيذ البحث
        function searchItems() {
            const keyword = document.getElementById("searchKeyword").value.trim();
            if (keyword.length < 2) return;

            fetch(`/Item/SearchForPurchase?term=${encodeURIComponent(keyword)}`)
                .then(res => res.json())
                .then(data => {
                    const tbody = document.getElementById("searchResults");
                    if (data.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="4">لا توجد نتائج</td></tr>`;
                        return;
                    }

                    tbody.innerHTML = data.map(item => `
                        <tr>
                            <td>${item.barcode}</td>
                            <td>${item.description}</td>
                            <td><button class="btn btn-sm btn-primary" onclick='selectItemFromSearch(${JSON.stringify(item)})'>اختيار</button></td>
                        </tr>
                    `).join("");
                });
        }

        // تعبئة البيانات عند اختيار مادة من البحث
        function selectItemFromSearch(product) 
        {
            const currency = document.getElementById('pdCurrency').value;
            const inputRow = document.getElementById('inputRow');
            
            inputRow.querySelector('.barcode-input').value = product.barcode;
            inputRow.querySelector('.description-input').value = product.description;
            
            const typeSelect = inputRow.querySelector('.type-select');
            if (product.typeName === 'قطعة') typeSelect.value = 'Piece';
            else if (product.typeName === 'طرد') typeSelect.value = 'Package';
            else if (product.typeName === 'كروز') typeSelect.value = 'Cruise';

            const price = currency === 'USD'
                ? (product.netAmountInDollar || 1)
                : (product.netAmount || 1);

            inputRow.querySelector('.price-input').value = price;
            inputRow.querySelector('.quantity-input').value = 1;

            // حساب الإجمالي = السعر × الكمية
            inputRow.querySelector('.total-input').value = price * 1;

            // إغلاق المودال
            const modal = bootstrap.Modal.getInstance(document.getElementById('itemSearchModal'));
            modal.hide();
        }

        
        function finalizeInputRow(button) {
            const row = button.closest('tr');
            convertInputRowToDataRow(row);
        }
        function updateRowTotal(input) {
            const row = input.closest('tr');
            const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
            const price = parseFloat(row.querySelector('.price-input').value) || 0;
            const totalInput = row.querySelector('.total-input');
            totalInput.value = (qty * price).toFixed(2);
        }


    </script>

}
