@model IEnumerable<Castel.DTO.InvoiceDTO>

@{
    ViewData["Title"] = "فواتير البيع";
}

<h1>فواتير البيع</h1>
<hr />
<div class="row">
    <div class="col-md-4 mb-2">
        <label for="id" style="font-weight:bold;">رقم:</label>
        <input type="number" class="form-control" id="idFilter" style="width:fit-content" />
    </div>
    <div class="col-md-4 mb-2">
        <label for="startdate" style="font-weight:bold;">اختر تاريخ البداية:</label>
        <input type="date" class="form-control" id="startdateFilter" style="width:fit-content" />
    </div>
    <div class="col-md-4 mb-2">
        <label for="enddate" style="font-weight:bold;">اختر تاريخ النهاية:</label>
        <input type="date" class="form-control" id="enddateFilter" style="width:fit-content" />
    </div>
</div>
<hr />

<table class="table table-striped table-bordered text-center align-middle" id="table">
    <thead>
        <tr>
            <th>                الرقم            </th>
            <th>                اجمالي الفاتورة            </th>
            <th>                تاريخ الفاتورة            </th>
            <th>                البائع            </th>
            <th>                العمليات            </th>
        </tr>
    </thead>
    <tbody>
        @{
            double totalSum = 0;
        }
        @foreach (var item in Model) {
            totalSum += item.NetAmount;
            <tr data-date=" @item.CreatedOn.ToString("yyyy-MM-dd")" data-id="@item.Id">
                <td>@item.Id</td>
                <td>@(item.NetAmount.ToString("N0") + " ل.س")</td>
                <td>@item.CreatedOn.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("ar-SY"))</td>
                <td>@Html.DisplayFor(modelItem => item.CreatedBy)</td>
                <td>
                    <a class="btn btn-primary" asp-action="GetSaledItem" asp-route-id="@item.Id">عرض التفاصيل</a>
                </td>
            </tr>
}
    </tbody>
</table>
<div class="mt-3">
    <strong>الإجمالي الكلي:</strong> <span id="total">@totalSum.ToString("N0")  ل.س</span>
</div>

@section Scripts {
    <script>
        const startdateInput = document.getElementById("startdateFilter");
        const enddateInput = document.getElementById("enddateFilter");
        const idInput = document.getElementById("idFilter");
        const rows = document.querySelectorAll("table tbody tr");

        function applyFilters(){
            const selectedId = idInput.value ? idInput.value : null;
            const selectedstartDate = startdateInput.value ? new Date(startdateInput.value + "T00:00:00") : null;
            const selectedendDate = enddateInput.value ? new Date(enddateInput.value + "T23:59:59") : null;
            rows.forEach(row => {
                const rowId = row.getAttribute('data-id');
                const rowDateStr = row.getAttribute("data-date");
                const rowDate = new Date(rowDateStr);
                const idMatch = (!selectedId || rowId === selectedId);
                const dateMatch = (!selectedstartDate || rowDate >= selectedstartDate)
                                    && (!selectedendDate || rowDate <= selectedendDate);
                if (idMatch && dateMatch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
            changeTotal();
        }
        function changeTotal(){
            let newTotal = 0;
            rows.forEach(row =>{
                if(row.style.display === ""){
                    const price = row.cells[1];
                    const textPrice = price.textContent;

                    const cleanPrice = textPrice.replace(/[^\d.]/g, "").replace(/,/g, "");
                    const number = parseFloat(cleanPrice);

                    console.log(number);
                    newTotal += number;
                }
            });
            const formattedTotal = newTotal.toLocaleString('ar-SY') + " ل.س";
            document.getElementById("total").textContent = formattedTotal
        }
        // تفعيل الفلاتر عند التغيير
        idInput.addEventListener('change', applyFilters);
        startdateInput.addEventListener('change', applyFilters);
        enddateInput.addEventListener('change', applyFilters);
    </script>
    
}