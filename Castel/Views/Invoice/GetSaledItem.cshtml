@model IEnumerable<Castel.DTO.InvoiceItemDTO>

@{
    ViewData["Title"] = "قائمة العناصر المباعة";
}

<h1>قائمة العناصر المباعة</h1>

<hr />
@if (ViewBag.Divisions != null)
{
<div class="row">
    <div class="col-md-3 mb-2">
        <label for="divisionId" style="font-weight:bold;">اختر القسم:</label>
         <select id="divisionSelect" class="form-select" style="width:fit-content">
            <option value="all">الكل</option>
        </select>
    </div>
    <div class="col-md-3 mb-2">
        <label for="startdate" style="font-weight:bold;">اختر تاريخ البداية:</label>
        <input type="date" class="form-control" id="startdateFilter" style="width:fit-content" />
    </div>
    <div class="col-md-3 mb-2">
        <label for="enddate" style="font-weight:bold;">اختر تاريخ النهاية:</label>
        <input type="date" class="form-control" id="enddateFilter" style="width:fit-content" />
    </div>
    <div class="col-md-3 mb-2">
        <a asp-action="GetSaleInvoice" class="btn btn-primary" style="width:fit-content">العودة الى قائمة الفواتير</a>
    </div>
</div>
}
<hr />
<table class="table table-striped table-bordered text-center align-middle" id="table">
    <thead>
        <tr>
            <th>                الرقم            </th>
            <th>                المادة            </th>
            <th>                القسم            </th>
            <th>                السعر            </th>
            <th>                الكمية            </th>
            <th>                الاجمالي            </th>
            <th>                البائع            </th>
            <th>                التاريخ            </th>
        </tr>
    </thead>
    <tbody>
        @{
            double totalSum = 0;
        }
@foreach (var item in Model) {
            totalSum += item.Total;
            <tr data-division="@item.DivisionName" data-date=" @item.CreatedOn.ToString("yyyy-MM-dd")">
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DivisionName)
            </td>
            <td>
                @(item.Price.ToString("N0") + " ل.س")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QTY)
            </td>
            <td>
                @(item.Total.ToString("N0") + " ل.س")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedBy)
            </td>
            <td>
                @item.CreatedOn.ToString("dd/MM/yyyy", new System.Globalization.CultureInfo("ar-SY"))
            </td>
        </tr>
        
}
    </tbody>
</table>
<div class="mt-3">
    <strong>الإجمالي الكلي:</strong> <span id="total">@totalSum.ToString("N0")  ل.س</span>
</div>

@section Scripts {
    <script>
        // جلب الأقسام من ViewBag وتحويلها إلى JavaScript
        const divisions = @Html.Raw(Json.Serialize(ViewBag.Divisions));
        // تعبئة القائمة
        const select = document.getElementById('divisionSelect');
        divisions.forEach(d => {
            const option = document.createElement('option');
            option.value = d.name;
            option.text = d.name;
            console.log(d);
            select.appendChild(option);
        });

        const startdateInput = document.getElementById("startdateFilter");
        const enddateInput = document.getElementById("enddateFilter");
        const rows = document.querySelectorAll("table tbody tr");

        function applyFilters(){
            const selected = select.value;
            const selectedstartDate = startdateInput.value ? new Date(startdateInput.value + "T00:00:00") : null;
            const selectedendDate = enddateInput.value ? new Date(enddateInput.value + "T23:59:59") : null;
            rows.forEach(row => {
                const rowDivision = row.getAttribute('data-division');
                const rowDateStr = row.getAttribute("data-date");
                const rowDate = new Date(rowDateStr);
                const divisionMatch = (selected === "all" || rowDivision === selected);
                const dateMatch = (!selectedstartDate || rowDate >= selectedstartDate) && (!selectedendDate || rowDate <= selectedendDate);
                if (divisionMatch && dateMatch) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
            changeTotal();
        }
        function changeTotal(){
            let newTotal = 0;
            rows.forEach(row =>{
                if(row.style.display === ""){
                    const price = row.cells[5];
                    const textPrice = price.textContent;

                    const cleanPrice = textPrice.replace(/[^\d.]/g, "").replace(/,/g, "");
                    const number = parseFloat(cleanPrice);

                    console.log(number);
                    newTotal += number;
                }
            });
            const formattedTotal = newTotal.toLocaleString('ar-SY') + " ل.س";
            document.getElementById("total").textContent = formattedTotal
        }
        // تفعيل الفلاتر عند التغيير
        select.addEventListener('change', applyFilters);
        startdateInput.addEventListener('change', applyFilters);
        enddateInput.addEventListener('change', applyFilters);
    </script>
}