@model Castel.DTO.GetVendorDTO

@{
    ViewData["Title"] = "حذف المورد";
}

<h1>حذف المورد</h1>

<h3>هل انت متأكد من حذف هضا العنصر ؟</h3>
<div>
    <h4>GetVendorDTO</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2" hidden>
            @Html.DisplayNameFor(model => model.id)
        </dt>
        <dd class = "col-sm-10" hidden>
            @Html.DisplayFor(model => model.id)
        </dd>
        <dt class = "col-sm-2">
            اسم المورد
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            الاسم المختصر
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ShortName)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="حذف" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-primary">العودة الى قائمة الاقسام</a>
    </form>
</div>
