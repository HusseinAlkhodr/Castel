@model Castel.DTO.GetVendorDTO

@{
    ViewData["Title"] = "تفاصيل المورد";
}

<h1>تفاصيل المورد</h1>

<div class="container">
    <div class="row mb-2">
        <div class="col-sm-6">
            <strong>الأسم:</strong> @Model.Name
        </div>
        <div class="col-sm-6">
            <strong>الإسم المختصر:</strong> @Model.ShortName
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-sm-6">
            <strong>العمليات:</strong>
            <a asp-action="Delete" asp-route-id="@Model.id" class="btn btn-danger btn-sm">حذف</a>
            <a asp-action="Edit" asp-route-id="@Model.id" class="btn btn-warning btn-sm">تعديل</a>
        </div>
    </div>
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">العودة إلى القائمة</a>
    </div>
</div>
